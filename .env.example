# ==============================================================================
# CareerForge Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Model Provider (Miễn phí 100% qua Google AI Studio Gemini 1.5 Flash)
# ------------------------------------------------------------------------------
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey (Không cần thẻ tín dụng)
# Hạn mức miễn phí: 15 lượt/phút, 1.500 lượt/ngày, 1.000.000 tokens/phút
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Các nhà cung cấp khác (Tùy chọn)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LOCAL_LLM_URL=http://localhost:8000/v1

# ------------------------------------------------------------------------------
# 2. Database & Vector Engine (Chạy qua docker/docker-compose.yml)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://careerforge:careerforge_secret@localhost:5434/careerforge_db
REDIS_URL=redis://localhost:6381/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=careerforge-resumes
MINIO_SECURE=False
